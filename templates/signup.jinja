<!-- 
Sign up page, pretty much the same as login.
-->
{% extends 'base.jinja' %}


{% block content %} 
    <style>
        body {
            background-color: #DDF2D1;
            font-family: Arial, sans-serif;
        }

    </style>
    
    <h1>Sign Up</h1>
    <p>Username</p>
    <input id="username"/>
    <p>Password</p>
    <input id="password" type="password"/>
    <p>User Type</p>
    <select id="userType">
        <option value="student">Student</option>
        <option value="staff">Staff</option>
    </select>
    <div id="passphraseDiv" style="display: none;">
        <p>Passphrase</p>
        <input id="passphrase" type="password"/>
    </div>
    <button onclick="signup()">Sign up</button>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>

        $("#password").on("keyup", (e) => {
            if (e.key == "Enter") {
                signup();
            }
        });

        $("#userType").on("change", function() {
            if ($("#userType").val() === "staff") {
                $("#passphraseDiv").show();
            } else {
                $("#passphraseDiv").hide();
            }
        });

         function isValidURL(string) {
            if (string.length == 0) {
                return false;
            }
            if (string[0] == "/") {
                return true;
            }
            return false;
        }

        async function generateKeyPair() {
            const encryptionKeyPair = await window.crypto.subtle.generateKey(
                {
                    name: "RSA-OAEP",
                    modulusLength: 2048,
                    publicExponent: new Uint8Array([1, 0, 1]),
                    hash: "SHA-256",
                },
                true,
                ["encrypt", "decrypt"]
            );
            const signingKeyPair = await window.crypto.subtle.generateKey(
                {
                    name: "RSASSA-PKCS1-v1_5",
                    modulusLength: 2048,
                    publicExponent: new Uint8Array([1, 0, 1]),
                    hash: "SHA-256",
                },
                true,
                ["sign", "verify"]
            );
            return {encryptionKeyPair, signingKeyPair};
        }
        
        // Export key object to a storable string, handling both private and public keys
        async function exportKey(key, keyType) {
            let exportFormat = keyType === 'private' ? "pkcs8" : "spki";
            const exported = await window.crypto.subtle.exportKey(exportFormat, key);
            const exportedAsString = String.fromCharCode.apply(null, new Uint8Array(exported));
            const exportedAsBase64 = window.btoa(exportedAsString);
            return exportedAsBase64;
        }

        //store private key in local storage
        async function storePrivateKey(username, keys) {
            const jsonKeys = JSON.stringify(keys);
            localStorage.setItem(username, jsonKeys);
        }


        // this function is identical to login(), see login.jinja
        async function signup() {
            let username = $("#username").val();
            let password = $("#password").val();
            let userType = $("#userType").val();
            let passphrase = $("#passphrase").val();
            
            const passphrase_key = "staff";

            if (userType === "staff" && passphrase !== passphrase_key) {
                alert("Passphrase is required for staff accounts.");
                return;
            }
            
            let salt = CryptoJS.lib.WordArray.random(16);
            // Hash the password using SHA-256 with salt
            let hashedPassword = CryptoJS.SHA256(password + salt).toString(CryptoJS.enc.Hex);
            let loginURL = "{{ url_for('signup_user') }}";
            let res = await axios.post(loginURL, {
                username: username,
                password: hashedPassword,
                userType: userType,
                salt: salt.toString(CryptoJS.enc.Hex)
            });
            if (!isValidURL(res.data)) {
                alert(res.data);
                return;
            }
            // Key creation. We create two sets of RSA keys - one for encryption/decryption and the other for signing/verifying.
            const keyPair = await generateKeyPair();
            const exportedPrivateKey = await exportKey(keyPair.encryptionKeyPair.privateKey, 'private');
            const exportedPublicKey = await exportKey(keyPair.encryptionKeyPair.publicKey, 'public');
            const exportedPrivateSigningKey = await exportKey(keyPair.signingKeyPair.privateKey, 'private');
            const exportedPublicSigningKey = await exportKey(keyPair.signingKeyPair.publicKey, 'public');
            storePrivateKey(username, {exportedPrivateKey, exportedPrivateSigningKey});
            let storeURL = "{{ url_for('store_public_key') }}";
            let storeRes = await axios.post(storeURL, {
                username: username,
                publicKey: {exportedPublicKey, exportedPublicSigningKey}
            });
            // Hash password + username again. This is stored into a cookie and used as a determinant for PBKDF2 generation later.
            let hashedAgain = CryptoJS.SHA256(hashedPassword+username).toString(CryptoJS.enc.Hex);
            Cookies.set('hash', hashedAgain);
            window.open(res.data, "_self")
        }
    </script>
{% endblock %}
