{% extends 'base.jinja' %}

{% block content %} 
    <style>
        nav {
            border-bottom: 1px solid black;
            overflow: auto
        }

        body {
            background-color: #DDF2D1;
            font-family: Arial, sans-serif;
        }

        .home-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
    
        .home-button:hover {
            background-color: #45a049;
        }
    
        .forum-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
    
        .forum-button:hover {
            background-color: #45a049;
        }

        .delete-article-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
        .delete-article-button:hover {
            background-color: #45a049;
        }

        .article-container {
            background-color: #fff;
            border-radius: 20px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
            margin-bottom: 40px;
            padding: 30px;
        }
        
        .article-heading {
            margin-bottom: 20px;
        }
        
        .article-title {
            font-size: 32px;
            color: #333;
            margin-top: 0;
            margin-bottom: 10px;
            text-align: center;
        }
        
        .article-details {
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
        
        .article-author {
            font-size: 18px;
            color: #555;
            margin-bottom: 10px;
        }
        
        .article-content {
            font-size: 16px;
            color: #333;
            line-height: 1.6;
        }

        textarea#title {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }
        
        textarea#content {
            width: 100%;
            height: 300px; /* Adjust height as needed */
            padding: 10px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }
        .profile-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
    
        .profile-button:hover {
            background-color: #45a049;
        }
    </style>

    <nav style="border-bottom: 1px solid black;">
        <ol style="float: left">
            <a href="{{ url_for('home', username=user.username) }}" class="home-button">Chat</a>
        </ol>
        <ol style="float: left">
            <a href="{{ url_for('forum') }}" class="forum-button">Forum</a>
        </ol>
        <ol style="float: left">
            <a href="{{ url_for('user_page', username=user.username) }}" class="profile-button">Profile</a>
        </ol>
        <ol style="float: right; text-align: right;"; >
            <input type="text" id="search-input" placeholder="Search for user..." style="margin-right: 1px;">
            <button onclick="searchForUser()" style="margin-right: 100px;">Search</button>
            <li style="display:inline-block">Username:  {{ user.username }} </li>
            <li style="display:block">Account type:  {{ user.user_type }} </li>
            <button style="display:inline-block" onclick="confirmSignOut()"><a class="sign-out-button">Sign out</a></button>

        </ol>
    </nav>

    <div class="article-container">
        <div class="article-heading">
            <h1 class="article-title">{{ article.title }}</h1>
        </div>
        <div class="article-details">
            <p class="article-author"><strong>Author:</strong> {{ article.author }}</p>

            {% if user.username == article.author or user.user_type == "staff" %}
                <form action="{{ url_for('delete_article', article_id=article.id) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this article?')">
                    <button type="submit" class="delete-article-button">Delete Article</button>
                </form>
                <!-- Edit Article Form -->
                <form action="{{ url_for('edit_article', article_id=article.id) }}" method="POST">
                    <label for="title">Title:</label><br>
                    <textarea id="title" name="title">{{ article.title }}</textarea><br>
                    <label for="content">Content:</label><br>
                    <textarea id="content" name="content">{{ article.content }}</textarea><br>
                    <input type="submit" value="Save Changes">
                </form>
            {% endif %}
        </div>
    </div>
    <script>
        function confirmSignOut() {
            if (confirm("Are you sure you want to sign out?")) {
                window.location.href = "{{ url_for('index') }}";
            }
            else {
                console.log("Cancelled!");
                return;
            }
        }

        function searchForUser() {
            var userInput = document.getElementById('search-input').value;
            
            var xhr = new XMLHttpRequest();
            xhr.open("GET", "/user/" + userInput, true);
            xhr.onreadystatechange = function() {
                if (xhr.readyState == 4) {
                    if (xhr.status == 200) {
                        window.location.href = "/user/" + userInput;
                    } else {
                        alert("User does not exist!");
                    }
                }
            };
            xhr.send();
        }
    </script>

{% endblock %}
