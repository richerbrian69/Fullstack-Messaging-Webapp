{% extends 'base.jinja' %}

{% block content %} 
    <style>
        nav {
            border-bottom: 1px solid black;
            overflow: auto
        }

        body {
            background-color: #DDF2D1;
            font-family: Arial, sans-serif;
        }

        .home-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
    
        .home-button:hover {
            background-color: #45a049;
        }
    
        .forum-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
        .forum-button:hover {
            background-color: #45a049;
        }

        .edit-article-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
        .edit-article-button:hover {
            background-color: #45a049;
        }


        .article-container {
            background-color: #fff;
            border-radius: 20px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
            margin-bottom: 40px;
            padding: 30px;
        }
        
        .article-heading {
            margin-bottom: 20px;
        }
        
        .article-title {
            font-size: 32px;
            color: #333;
            margin-top: 0;
            margin-bottom: 10px;
            text-align: center;
        }
        
        .article-details {
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
        
        .article-author {
            font-size: 18px;
            color: #555;
            margin-bottom: 10px;
        }
        
        .article-content {
            font-size: 16px;
            color: #333;
            line-height: 1.6;
        }


        .comments {
            margin-top: 20px;
        }
        .comments h2 {
            margin-bottom: 10px;
        }
        .comment-form {
            margin-bottom: 20px;
        }
        .comment-form label {
            display: block;
            margin-bottom: 5px;
        }
        .comment-form textarea {
            width: 42%;
            height: 69px;
            padding: 10px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }
        .comment-content {
            margin-left: 20px;
        }

        .comment-actions {
            margin-top: 5px; /* Adjust spacing between comment text and buttons */
        }
        
        .comment-actions button {
            display: in-line;
            margin-bottom: 5px; /* Adjust spacing between buttons */
        }
        .profile-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
            font-family: Arial, sans-serif;
        }
    
        .profile-button:hover {
            background-color: #45a049;
        }

    </style>

    <nav style="border-bottom: 1px solid black;">
        <ol style="float: left">
            <a href="{{ url_for('home', username=user.username) }}" class="home-button">Chat</a>
        </ol>
        <ol style="float: left">
            <a href="{{ url_for('forum') }}" class="forum-button">Forum</a>
        </ol>
        <ol style="float: left">
            <a href="{{ url_for('user_page', username=user.username) }}" class="profile-button">Profile</a>
        </ol>
        <ol style="float: right; text-align: right;"; >
            <input type="text" id="search-input" placeholder="Search for user..." style="margin-right: 1px;">
            <button onclick="searchForUser()" style="margin-right: 100px;">Search</button>
            <li style="display:inline-block">Username:  {{ user.username }} </li>
            <li style="display:block">Account type:  {{ user.user_type }} </li>
            <button style="display:inline-block" onclick="confirmSignOut()"><a class="sign-out-button">Sign out</a></button>

        </ol>
    </nav>

    <div class="article-container">
        <div class="article-heading">
            <h1 class="article-title">{{ article.title }}</h1>
        </div>
        <div class="article-details">
            <p class="article-author"><strong>Author:</strong> {{ article.author }}</p>
            {% if user.username == article.author or user.user_type == "staff" %}
                <a href="{{ url_for('edit_article', article_id=article.id) }}" class="edit-article-button">Edit Article</a>
            {% endif %}
            <div class="article-content">
                <p>{{ article.content | replace('\n', '<br>') | safe }}</p>
            </div>
        </div>
    </div>

    <div class="comments">
        <div class="comment-form">
            <form action="{{ url_for('add_comment', article_title=article.title) }}" method="POST">
                <label for="comment">Add a comment:</label><br>
                <textarea id="comment" name="comment"></textarea><br>
                <input type="submit" value="Submit">
            </form>
        </div>

        <h2>Comments ({{ article.comments|length }})</h2>
        <ul>
            {% for comment in article.comments %}
            <li>
                <strong>{{ comment.author }}:<br></strong>
                <span class="comment-content">{{ comment.content }}</span>
                {% if user.user_type == "staff" %}
                <div class="comment-actions">
                    <button type="button" class="delete-comment-button" data-comment-id="{{ comment.id }}" data-article-id="{{ article.id }}">Delete Comment</button>
                </div>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>

    <script>
        function confirmSignOut() {
            if (confirm("Are you sure you want to sign out?")) {
                window.location.href = "{{ url_for('index') }}";
            }
            else {
                console.log("Cancelled!");
                return;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Get all delete comment buttons
            var deleteButtons = document.querySelectorAll('.delete-comment-button');
    
            // Add event listener to each button
            deleteButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    // Get the comment ID from data attribute
                    var commentId = this.getAttribute('data-comment-id');
                    var articleId = this.getAttribute('data-article-id');
                    // Confirm deletion
                    var confirmDelete = confirm('Are you sure you want to delete this comment?');
                    
                    // If confirmed, perform deletion
                    if (confirmDelete) {
                        // You need to send the commentId to the server for deletion
                        fetch(`/delete_comment/${articleId}/${commentId}`, {
                            method: 'DELETE'
                        })
                        .then(response => {
                            if (response.ok) {
                                // Reload the page or update the UI as needed
                                window.location.reload(); // Reload the page
                            } else {
                                // Handle errors
                                console.error('Failed to delete comment');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                        });
                    }
                });
            });
        });

        function searchForUser() {
            var userInput = document.getElementById('search-input').value;
            
            var xhr = new XMLHttpRequest();
            xhr.open("GET", "/user/" + userInput, true);
            xhr.onreadystatechange = function() {
                if (xhr.readyState == 4) {
                    if (xhr.status == 200) {
                        window.location.href = "/user/" + userInput;
                    } else {
                        alert("User does not exist!");
                    }
                }
            };
            xhr.send();
        }
    </script>
{% endblock %}
