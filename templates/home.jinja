        if (addFriendArea.style.display === "none") {
            addFriendArea.style.display = "block"; // Show the add friend area
        } else {
            addFriendArea.style.display = "none"; // Hide the add friend area
        }
    }
    
    // Here's the Socket IO part of the code
    // things get a bit complicated here so brace yourselves :P

    // global variable declaration
    let username = "{{ user.username }}";
    let talking_to = null;
    let current_message = null;

    // Set username cookie. Remove room_id cookie -> relevant for when user relogs in.
    Cookies.set('username', username);
    Cookies.remove("room_id");

    // initializes the socket
    const socket = io();
    const { subtle } = window.crypto;

    socket.on("incoming_friend_request", (name) => {
        incoming_friend_request();
    })

