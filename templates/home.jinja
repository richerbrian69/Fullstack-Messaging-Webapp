    //socket.on("received", () => {
        //let message = current_message;
        //store_message(username+': '+message);
        //current_message = null;
    //})

    // create hash function
    async function sha256(message) {
        const msgBuffer = new TextEncoder().encode(message);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        return hashHex;
    }

    // Derive a key using PBKDF2
    async function importPBKDF2Key() {
        const encoder = new TextEncoder();
        const password = Cookies.get('hash'); // Give password as a parameter
        const passwordBuffer = encoder.encode(password);
    
        const pbkdf2Params = {
            name: "PBKDF2",
            salt: new Uint8Array('jesse'), // Salt is added -> set salt as predetermined string.
            iterations: 10000,
            hash: "SHA-256"
        };
    
        const derivedKey = await window.crypto.subtle.importKey(
            "raw",
            passwordBuffer,
            pbkdf2Params,
            false,
            ["deriveKey"]
        );
    
        const aesKeyParams = {
            name: "AES-GCM",
            length: 256 
        };
    
        const symmetricKey = await window.crypto.subtle.deriveKey(
            {
                name: "PBKDF2",
                salt: new Uint8Array('jesse'), // salt value must retain in order for predetermined key generation
                iterations: 10000,
                hash: "SHA-256"
            },
            derivedKey,
            aesKeyParams,
            true, 
            ["encrypt", "decrypt"]
        );
        return symmetricKey;
    }
    
    // symmetric encryption. will generate key in this function
    async function encryptStringWithPBKDF2Key(plaintext) {
        try {
            // Generates a key 
            const key = await importPBKDF2Key();
            const encoder = new TextEncoder();
            const plaintextBuffer = encoder.encode(plaintext);
            var iv = new Uint8Array(16);
            iv.fill(0);
        
            const encryptedData = await window.crypto.subtle.encrypt(
            {
                name: "AES-GCM",
                iv: iv,
            },
            key,
            plaintextBuffer
            );
            // Convert the encrypted data to base64
            const encryptedBase64 = btoa(String.fromCharCode(...new Uint8Array(encryptedData)));
            return encryptedBase64;
        } catch (error) {
            console.error("Encryption failed:", error);
            return null;
        }
      }

    // decrypt data using symmetric key
    async function decryptStringWithPBKDF2Key(encryptedBase64) {
        try {
            // The key is created within this function. View this function to see determinstic generation.
            const key = await importPBKDF2Key();
            const decoder = new TextDecoder();

            const encryptedUint8Array = Uint8Array.from(atob(encryptedBase64), c => c.charCodeAt(0));
    
            var iv = new Uint8Array(16);
            iv.fill(0); // Set IV to equal the same every time. Prevents randomness.
    
            const decryptedData = await window.crypto.subtle.decrypt(
                {
                    name: "AES-GCM",
                    iv: iv,
                },
                key,
                encryptedUint8Array
            );
    
            const decryptedString = decoder.decode(decryptedData);
            return decryptedString;
        } catch (error) {
            console.error("Decryption failed:", error);
            return null;
        }
    }

    // encrypt message using RSA public key
    async function encryptMessage(message, publicKey) {
        let encoder = new TextEncoder();
        let messageBytes = encoder.encode(message);
        // Encrypt the message
        let encryptedData = await window.crypto.subtle.encrypt(
            {
                name: "RSA-OAEP",
            },
            publicKey,
            messageBytes,
        );
        let ret = arrayBufferToBase64(encryptedData);
        return ret;
    }

    // decrypt message using RSA private key
    async function decryptMessage(encryptedMessage, privateKey) {
        encryptedMessage = base64ToArrayBuffer(encryptedMessage);
        try {
            const decryptedBytes = await window.crypto.subtle.decrypt(
            {
                name: 'RSA-OAEP',
            },
            privateKey,
            encryptedMessage,
            );
            const decoder = new TextDecoder();
            let decryptedMessage = decoder.decode(decryptedBytes);
            return decryptedMessage;
        } catch (error) {
            console.error('Error decrypting message:', error);
            throw error;
        }
    }

    // function to convert base64 string to array buffer
    function base64ToArrayBuffer(base64) {
        const binaryString = window.atob(base64);
        const bytes = new Uint8Array(binaryString.length);

        for (let i = 0; i < binaryString.length; i++) {
            bytes[i] = binaryString.charCodeAt(i);
        }

        return bytes.buffer;
    }

    // function to convert array buffer to base64 string
    function arrayBufferToBase64(buffer) {
        const bytes = new Uint8Array(buffer);
        const binaryString = new Array(bytes.length);
        for (let i = 0; i < bytes.length; i++) {
            binaryString[i] = String.fromCharCode(bytes[i]);
        }
        return window.btoa(binaryString.join(''));
    }

    // function to retrieve public key of user
    async function getPublicKey(username) {
        try {
            const response = await axios.get(`/public_key/${username}`);
            const publicKey = response.data;
            return publicKey;
        } catch (error) {
            throw new Error('Error retrieving public key');
        }
    }

    async function getPublicSigKey(username) {
        try {
            const response = await axios.get(`/public_sig_key/${username}`);
            const publicKey = response.data;
            return publicKey;
        } catch (error) {
            throw new Error('Error retrieving public key');
        }
    }

    // function to import key from given 64bit string
    async function importKey(keyBase64, keyType) {
        const keyBytes = Uint8Array.from(atob(keyBase64), c => c.charCodeAt(0));
        const importFormat = keyType === 'private' ? 'pkcs8' : 'spki';
        const keyUsages = keyType === 'private' ? ['decrypt'] : ['encrypt'];
        try {
            const importedKey = await window.crypto.subtle.importKey(
                importFormat,
                keyBytes,
                {
                    name: 'RSA-OAEP',
                    hash: 'SHA-256',
                },
                true,
                keyUsages
            );
            return importedKey;
        } catch (error) {
            console.error('Error importing key:', error);
            throw error;
        }
    }

    async function importSigKey(keyBase64, keyType) {
        const keyBytes = Uint8Array.from(atob(keyBase64), c => c.charCodeAt(0));
        const importFormat = keyType === 'private' ? 'pkcs8' : 'spki';
        const keyAlgorithm = { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' };
        const keyUsages = keyType === 'private' ? ['sign'] : ['verify'];
    
        try {
            const importedKey = await window.crypto.subtle.importKey(
                importFormat,
                keyBytes,
                keyAlgorithm,
                true,
                keyUsages
            );
            return importedKey;
        } catch (error) {
            console.error('Error importing key:', error);
            throw error;
        }
    }
    

    async function signMessage(privateKey, message) {
        const signature = await window.crypto.subtle.sign(
            {
                name: "RSASSA-PKCS1-v1_5", // RSASSA-PKCS1-v1_5 is used for signing with RSA
            },
            privateKey,
            new TextEncoder().encode(message) // Convert the message to bytes
        );
        return signature;
    }

    async function verifySignature(publicKey, signature, message) {
        const signatureBytes = Uint8Array.from(atob(signature), c => c.charCodeAt(0));
        try {
            // Convert the message to bytes
            const messageBytes = new TextEncoder().encode(message);
    
            // Verify the signature
            const isVerified = await window.crypto.subtle.verify(
                {
                    name: "RSASSA-PKCS1-v1_5",
                    hash: { name: "SHA-256" },
                },
                publicKey,
                signatureBytes,
                messageBytes
            );
    
            return isVerified;
        } catch (error) {
            console.error('Error verifying signature:', error);
            throw error;
        }
    }

    
    // send message function. invokes RSA encryption
    async function send() {
