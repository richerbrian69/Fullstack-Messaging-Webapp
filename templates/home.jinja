        // Get friends public key for digital signature
        //let friendsPublicKeyString = await getPublicSigKey(friendName);
        //let friendsPublicKey = await importSigKey(friendsPublicKeyString, 'public');
        // Verify signature received - Give senders public key, received signature and own computed hash message as arguments.
        //let verified = await verifySignature(friendsPublicKey, encodedSignature, decryptedHash);
        //if (verified){
        //store_message(friendName+': ' + message);
        add_message(friendName + ': ' + message, color);

        //} else {
	      //  store_message(friendName+': '+decryptedMessage+' (HMAC Error - Cannot verify)');
          //  add_message(friendName + ': ' +decryptedMessage+ ' (HMAC Error - Cannot verify)', color);
        //}
