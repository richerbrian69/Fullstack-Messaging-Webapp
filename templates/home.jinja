<!--Navbar, you'll see the username here-->
<nav style="border-bottom: 1px solid black;">
    <ol style="float: left">
        <a href="{{ url_for('home', username=user.username) }}" class="home-button">Chat</a>
    </ol>
    <ol style="float: left">
        <a href="{{ url_for('forum') }}" class="forum-button">Forum</a>
    </ol>
    <ol style="float: left">
        <a href="{{ url_for('user_page', username=user.username) }}" class="profile-button">Profile</a>
    </ol>
    <ol style="float: right; text-align: right;"; >
        <input type="text" id="search-input" placeholder="Search for user..." style="margin-right: 1px;">
        <button onclick="searchForUser()" style="margin-right: 100px;">Search</button>
        <li style="display:inline-block">Username:  {{ user.username }} </li>
        <li style="display:block">Account type:  {{ user.user_type }} </li>
        <button style="display:inline-block" onclick="confirmSignOut()"><a class="sign-out-button">Sign out</a></button>

    </ol>
</nav>

<h2 class="app-title">Messaging App</h2>
<!-- Button to bring up incoming friend requests overlay -->
<div style="display: flex;">
    <aside id="create_chatroom_button">
        <button onclick="toggleCreateChatroom()">Create Chatroom</button>
    </aside>
    <aside id="incoming_requests_button">
        <button onclick="toggleIncomingRequestsArea()">View Incoming Friend Requests</button>
    </aside>
</div>
<main class="container">
    <!-- Declaration of section -->
    <!-- Group Chat Area-->
    <aside id="group_chat_area">
        <h2> Your Chatrooms </h2>
        {% if group_chats and group_chats != [''] %}
            <ul>
                {% for chat, members in group_chats.items() %}
                    <li><a href="#" onclick="join_chatroom('{{ chat }}');">{{ members|join(', ') }}'s chatroom</a></li>
                {% endfor %}
            </ul>
        {% else %}
            No chatrooms
        {% endif %}
    </aside>

    <section id="message_box"></section>

    <!-- Friends list area-->
    <aside id="friends_list">
        <h2>Friends List</h2>
        {% if friends and friends != [''] %}
            <ul>
                {% for friend in friends %}
                    <div style="display: flex; justify-content: space-between; align-items: center;" class="friend-info" id="{{ friend.username }}">
                        <li><a href="#" onclick="join_room('{{ friend.username }}');">{{ friend.username }}</a></li>
                        <span>({{ friend.user_type }})</span>
                        <button onclick="remove_friend('{{ friend.username }}')" style="margin-left: 5px;">✕</button>
                    </div>
                {% endfor %}
            </ul>
        {% else %}
            No friends to display
        {% endif %}
    </aside>
    
    <!-- Incoming friend requests area (overlay box) -->
    <aside id="incoming_requests_area" style="display: none;">
        <div id="incoming_requests_overlay"></div> <!-- Overlay background -->
        <div id="incoming_requests_box"> <!-- Box content -->
            <button onclick="toggleIncomingRequestsArea()" id="close_incoming_button">✕</button> <!-- X symbol -->
            <h2>Incoming Requests</h2>
            {% if friend_requests and friend_requests != [''] %}
                <ul>
                    {% for request in friend_requests %}
                        <li><a href="#" onclick="toggleHighlight(this); return false;" class="name">{{ request }}</a></li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>No incoming friend requests</p>
            {% endif %}
            <aside id="friend-buttons">
                <button onclick="acceptFriendRequests()">Accept</button>
                <button onclick="rejectFriendRequests()">Reject</button>
            </aside>
        </div>
    </aside>



    <aside id="create_chatroom_area" style="display: none;">
        <div id="create_chatroom_overlay"></div> <!-- Overlay background -->
        <div id="create_chatroom_box"> <!-- Box content -->
            <button onclick="toggleCreateChatroom()" id="close_chatroom_button">✕</button> <!-- X symbol -->
            <h2>Select friends to add</h2>
            {% if friends and friends != [''] %}
                <ul>
                    {% for friend in friends %}
                        <li><a href="#" onclick="toggleHighlight(this); return false;" class="name">{{ friend.username }}</a></li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>No friends</p>
            {% endif %}
            <aside id="create-button">
                <button onclick="createChatRoom()">Create</button>
            </aside>
        </div>
    </aside>
</main>



<section class='container'>
    <!-- This section is for the buttons and input boxes beneath the message and friends area-->
    <section id="chat_box">
        <p class="text">Chat: </p>
        <input id="receiver" placeholder="Message">
        <button onclick="send()">Chat</button>
        <button onclick="leave()">Leave Room</button>
    </section>
    <!-- Add New Friend button -->
    <aside id="add_friend_button">
        <button onclick="toggleAddFriendArea()">Add New Friend</button>
    </aside>

    <!-- Add Friend Area (overlay box) -->
    <aside id="add_friend_area" style="display: none;">
        <div id="add_friend_overlay"></div> <!-- Overlay background -->
        <div id="add_friend_box"> <!-- Box content -->
            <button onclick="toggleAddFriendArea()" id="close_button">✕</button>
            <input id="friend" placeholder="Name">
            <button onclick="add_friend()">Submit</button>
        </div>
    </aside>
</section>


<script src="/static/js/libs/socket.io.min.js"></script>
<script>
    
    // when the user presses the "Enter" key inside of the "message box", 
    // the message is sent to the server
    $("#receiver").on("keyup", (e) => {
        if (e.key == "Enter") {
            send();
        }
    })

