    // an incoming encrypted message is received. message needs to be decrypted with private key. MAC integrity is also confirmed
    socket.on("receive", async (friendName, message, color="black") => {
        // Get own private key to decrypt
        //const privateKeys = JSON.parse(localStorage.getItem(username));
