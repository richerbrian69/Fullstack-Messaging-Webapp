        // Get receivers public key
        
        //let friendsPublicKeyString = await getPublicKey(talking_to);
        //let friendsPublicKey = await importKey(friendsPublicKeyString, 'public');
        try{
            current_message = message;
            //First add message to message box
            add_message(username + ': ' + message, 'black');
            // Encrypt using receivers key
            //let encryptedMessage = await encryptMessage(message, friendsPublicKey);
            // Hash the message
            //let hashedMessage = await sha256(message);
            // Get own private key for signature
            //const privateKeys = JSON.parse(localStorage.getItem(username));
            //const privateSigningKey = privateKeys.exportedPrivateSigningKey;
            //const privateKey = await importSigKey(privateSigningKey, 'private');
            // Create signature from private key and hashed message
            //const signature = await signMessage(privateKey, hashedMessage);
            //const encodedSignature = btoa(String.fromCharCode(...new Uint8Array(signature)));
            // Message is sent along with the signature
            socket.emit("send", username, message, Cookies.get('room_id'));
        } catch(error) {
            console.error(error);
        }
    }

    async function join_chatroom(id) {
        if (Cookies.get('room_id') != undefined) {
            leave();
        }
        let box = $("#message_box");
        $("#message_box").empty();
        let joinPromise = new Promise((resolve, reject) => {
            socket.emit("join_room", username, id, (res) => {
                if (typeof res != "number") {
                    alert(res);
                    reject(res);
                } else {
                    room_id = res;
                    Cookies.set("room_id", room_id);
                    resolve(room_id);
                }
            });
        });

        try {
            // Wait for the joinPromise to resolve before continuing
            let room_id = await joinPromise;
            
            // Delay execution using setTimeout to ensure the cookie is set
            setTimeout(async () => {
                let url = "{{ url_for('get_message_history') }}";
                let messageRes = await axios.post(url, {});
                if (messageRes.data != 'None' && messageRes.data !== undefined) {
                    for (const message of messageRes.data) {
                        add_message(message);
                    }
                }
            }, 5); // Adjust the delay time as needed
        } catch (error) {
            console.error("Error joining room:", error);
        }
    }

    // we emit a join room event to the server to join a room
    async function join_room(friend) {
        if (Cookies.get('room_id') != undefined) {
            leave();
        }
        talking_to = friend;
        let box = $("#message_box");
        $("#message_box").empty();
    
        // Promisify the socket.emit callback to ensure it finishes before proceeding
        let joinPromise = new Promise((resolve, reject) => {
            socket.emit("join", username, friend, (res) => {
                if (typeof res != "number") {
                    alert(res);
                    reject(res);
                } else {
                    room_id = res;
                    Cookies.set("room_id", room_id);
                    resolve(room_id);
                }
            });
        });
    
        try {
            // Wait for the joinPromise to resolve before continuing
            let room_id = await joinPromise;
            
            // Delay execution using setTimeout to ensure the cookie is set
            setTimeout(async () => {
                let url = "{{ url_for('get_message_history') }}";
                let messageRes = await axios.post(url, {});
                if (messageRes.data != 'None' && messageRes.data !== undefined) {
                    for (const message of messageRes.data) {
                        add_message(message);
                    }
                }
            }, 5); // Adjust the delay time as needed
        } catch (error) {
            console.error("Error joining room:", error);
        }
    }

    function searchForUser() {
        var userInput = document.getElementById('search-input').value;
        
        var xhr = new XMLHttpRequest();
        xhr.open("GET", "/user/" + userInput, true);
        xhr.onreadystatechange = function() {
            if (xhr.readyState == 4) {
                if (xhr.status == 200) {
                    window.location.href = "/user/" + userInput;
                } else {
                    alert("User does not exist!");
                }
            }
        };
        xhr.send();
    }
    
    // function when the user clicks on "Leave Room"
    // emits a "leave" event, telling the server that we want to leave the room
    function leave() {
        if (Cookies.get("room_id") == null) {
            return;
        }
        $("#message_box").empty();
        socket.emit("leave", username, Cookies.get("room_id"));
        Cookies.remove("room_id");
        talking_to = null;
    }

    // function to add a message to the message box
    // called when an incoming message has reached a client
    function add_message(message, color) {
        let box = $("#message_box");
        let child = $(`<p style="color:${color}; margin: 0px;"></p>`).text(message);
        box.append(child);
    }

    // function to grab friend requests
    async function incoming_friend_request() {
        let url = "{{ url_for('get_friend_requests') }}";
        let res = await axios.post(url, {
            username
        });
        if (res.data == "Not authenticated!") {
            return;
        }
        friend_requests = res.data;
        update_friend_requests(friend_requests);
        return;
    }

    // add friend function
    async function add_friend() {
        let friendName = $("#friend").val();
        let addURL = "{{ url_for('add_friend') }}";
        let res = await axios.post(addURL, {
            friendName: $("#friend").val(),
            username
        });
        socket.emit('add_friend', username, friendName);
        outgoing_friend_request();
        alert(res.data);
        return;
    }

    async function remove_friend(friend) {
        let confirmation = confirm("Are you sure you want to remove this friend?");
        if (!confirmation) {
            return; // If user cancels, do nothing
        }
        let friendName = friend;
        let removeURL = "{{ url_for('remove_friend') }}";
        let res = await axios.post(removeURL, {
            friendName: friend,
            username: username
        });
        socket.emit('removed_friend', username, friendName);
        get_friends_list();
        alert(res.data);
        return;
    }

    // function to grab outgoing friend requests
    async function outgoing_friend_request() {
        let url = "{{ url_for('get_outgoing_friend_requests') }}";
        let res = await axios.post(url, {
            username
        });
        if (res.data == "Not authenticated!") {
            return;
        }
        outgoing_friend_requests = res.data;
        update_outgoing_friend_requests(outgoing_friend_requests);
        return;
    }

    // function to update incoming friend requests
    function update_friend_requests(friendRequests) {
        const incomingRequestsArea = document.getElementById('incoming_requests_area');
    
        incomingRequestsArea.innerHTML = '';
        const incomingRequestsOverlay = document.createElement('div');
        incomingRequestsOverlay.id = 'incoming_requests_overlay';
    
        const incomingRequestsBox = document.createElement('div');
        incomingRequestsBox.id = 'incoming_requests_box';
    
        const closeButton = document.createElement('button');
        closeButton.id = 'close_incoming_button';
        closeButton.textContent = '✕'; // X symbol
        closeButton.onclick = function() {
            toggleIncomingRequestsArea();
        };
        incomingRequestsBox.appendChild(closeButton);
    
        const header = document.createElement('h2');
        header.textContent = 'Incoming Requests';
        incomingRequestsBox.appendChild(header);
    
        if (friendRequests.length > 0 && friendRequests != '') {
            const list = document.createElement('ul');
            friendRequests.forEach(request => {
                const listItem = document.createElement('li');
                const link = document.createElement('a');
                link.href = '#';
                link.textContent = request;
                link.onclick = function() {
                    toggleHighlight(this);
                    return false;
                };
                listItem.appendChild(link);
                list.appendChild(listItem);
            });
            incomingRequestsBox.appendChild(list);
        } else {
            const message = document.createElement('p');
            message.textContent = 'No incoming friend requests';
            incomingRequestsBox.appendChild(message);
        }
    
        // Add accept and reject buttons
        const acceptButton = document.createElement('button');
        acceptButton.textContent = 'Accept';
        acceptButton.onclick = function() {
            acceptFriendRequests();
        };
        incomingRequestsBox.appendChild(acceptButton);
    
        const rejectButton = document.createElement('button');
        rejectButton.textContent = 'Reject';
        rejectButton.onclick = function() {
            rejectFriendRequests();
        };
        incomingRequestsBox.appendChild(rejectButton);
        incomingRequestsArea.appendChild(incomingRequestsOverlay);
        incomingRequestsArea.appendChild(incomingRequestsBox);
    }

    // function to update outgoing friend request
    function update_outgoing_friend_requests(friendRequests) {
        const outgoingRequestsList = document.getElementById('outgoing_requests');
        outgoingRequestsList.innerHTML = '';

        const header = document.createElement('h2');
        header.textContent = 'Outgoing Requests';
        outgoingRequestsList.appendChild(header);

        if (friendRequests.length > 0 && friendRequests != '') {

            const list = document.createElement('ul');

            friendRequests.forEach(request => {
                const listItem = document.createElement('li');
                listItem.textContent = request;
                list.appendChild(listItem);
            });
    
            outgoingRequestsList.appendChild(list);
        } else {
            const message = document.createElement('p');
            message.textContent = 'No outgoing friend requests';
            outgoingRequestsList.appendChild(message);
        }
    }

    // function to update friends list
    function update_friends_list(friendsList) {
        const friends = document.getElementById('friends_list');
        friends.innerHTML = '';
        const header = document.createElement('h2');
        header.textContent = 'Friends List';
        friends.appendChild(header);
    
        if (friendsList.length > 0 && friendsList != '') {
            const list = document.createElement('ul');

            friendsList.forEach(request => {
                const listItem = document.createElement('li');
                const divContainer = document.createElement('div');
                divContainer.style.display = 'flex';
                divContainer.style.justifyContent = 'space-between';
                divContainer.style.alignItems = 'center';
                const link = document.createElement('a');
                link.href = '#';
                link.textContent = request.username;
                link.onclick = function() {
                    join_room(request.username);
                };

                const userTypeSpan = document.createElement('span');
                userTypeSpan.textContent = `(${request.user_type})`;

                const removeButton = document.createElement('button');
                removeButton.textContent = '✕';
                removeButton.style.marginLeft = '5px';
                removeButton.onclick = function() {
                    remove_friend(request.username);
                };
                divContainer.appendChild(link);
                divContainer.appendChild(userTypeSpan);
                divContainer.appendChild(removeButton);
                listItem.appendChild(divContainer);
                list.appendChild(listItem);
            });
    
            friends.appendChild(list);
        } else {
            const message = document.createElement('p');
            message.textContent = 'No friends to display';
            friends.appendChild(message);
        }
    }

    // simple function to toggle text highlight
    function toggleHighlight(element) {
        element.classList.toggle('highlight');
    }

    async function createChatRoom() {
        const highlightedNames = document.querySelectorAll('#create_chatroom_box .highlight');
        const highlightedNamesList = [username];
        
        for (const nameElement of highlightedNames) {
            const name = nameElement.textContent.trim();
            highlightedNamesList.push(name);
        }
    
        console.log("Highlighted Names:", highlightedNamesList);
        let url = "{{ url_for('create_chatroom') }}";
        let res = await axios.post(url, {
            highlightedNamesList
        });
        alert("Chatroom created!");
    }

    // function to accept friend requests
    async function acceptFriendRequests() {
        const highlightedNames = document.querySelectorAll('#incoming_requests_box .highlight');

        for (const nameElement of highlightedNames) {

            const name = nameElement.textContent;
            let url = "{{ url_for('accept_friend_requests') }}";
            let res = await axios.post(url, {
                friendName: name,
                username: username
            });
            if (res.data == "Not authenticated!") {
                return;
            }
            socket.emit('handled_request', username, name);
        }
        incoming_friend_request();
        get_friends_list();
    }
    
    // function to reject friend requests
    async function rejectFriendRequests() {
        const highlightedNames = document.querySelectorAll('#incoming_requests_box .highlight');
        
        for (const nameElement of highlightedNames) {
            const name = nameElement.textContent;
            let url = "{{ url_for('reject_friend_requests') }}";
            let res = await axios.post(url, {
                friendName: name,
                username: username
            });
            if (res.data == "Not authenticated!") {
                return;
            }
            socket.emit('handled_request', username, name);
        }
        incoming_friend_request();
        get_friends_list();
    }

    // function to get friends list
    async function get_friends_list() {
        let url = "{{ url_for('get_friends') }}";
        let res = await axios.post(url, {
            username
        });
        friends_list = res.data;
        update_friends_list(friends_list);
        return;
    }   

    
</script>
